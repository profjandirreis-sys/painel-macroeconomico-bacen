# Modelo de credenciais – copie para .streamlit/secrets.toml e preencha.
# O arquivo secrets.toml real NUNCA vai para o GitHub (está no .gitignore).
# No Streamlit Community Cloud, cole este conteúdo em: Settings → Secrets.
#
# Sem este arquivo (ou se o banco estiver fora do ar), o app usa a
# contingência local: data/processed/macro_indicadores.csv
#
# O banco precisa ter a tabela "macro_indicadores" com as mesmas colunas
# do CSV (ver docs/dicionario_dados.md).

[connections.postgresql]
dialect = "postgresql"
host = "SEU-HOST.supabase.co"
port = "5432"
database = "postgres"
username = "postgres"
password = "SUA-SENHA-AQUI"
# Desiste da conexão após 5 s e cai na contingência, em vez de travar o app
query = { connect_timeout = "5" }
